[
    {
        "id": "tab_lab6_act1",
        "type": "tab",
        "label": "Lab6 Act1 - Visualizacion IoT",
        "disabled": false,
        "info": "Recibe telemetria reenviada por la API propia (POST /visualize) y la muestra en gauges."
    },
    {
        "id": "http_in_visualizar",
        "type": "http in",
        "z": "tab_lab6_act1",
        "name": "POST /visualizar",
        "url": "/visualizar",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 120,
        "wires": [["fn_extraer_campos"]]
    },
    {
        "id": "fn_extraer_campos",
        "type": "function",
        "z": "tab_lab6_act1",
        "name": "Extraer temperatura/humedad/presion",
        "func": "const datos = Array.isArray(msg.payload) ? msg.payload[msg.payload.length - 1] : msg.payload;\n\nmsg.temperatura = { payload: datos.temperature };\nmsg.humedad = { payload: datos.humidity };\nmsg.presion = { payload: datos.pressure };\n\nreturn msg;",
        "outputs": 1,
        "x": 430,
        "y": 120,
        "wires": [["http_response_ok", "gauge_temperatura", "gauge_humedad", "gauge_presion"]]
    },
    {
        "id": "http_response_ok",
        "type": "http response",
        "z": "tab_lab6_act1",
        "name": "200 OK",
        "statusCode": "200",
        "headers": {},
        "x": 700,
        "y": 80,
        "wires": []
    },
    {
        "id": "gauge_temperatura",
        "type": "ui_gauge",
        "z": "tab_lab6_act1",
        "name": "Temperatura",
        "group": "ui_group_lab6",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Temperatura",
        "label": "°C",
        "format": "{{msg.temperatura.payload}}",
        "min": 0,
        "max": 50,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "30",
        "seg2": "40",
        "x": 700,
        "y": 140,
        "wires": []
    },
    {
        "id": "gauge_humedad",
        "type": "ui_gauge",
        "z": "tab_lab6_act1",
        "name": "Humedad",
        "group": "ui_group_lab6",
        "order": 2,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Humedad",
        "label": "%",
        "format": "{{msg.humedad.payload}}",
        "min": 0,
        "max": 100,
        "colors": ["#ca3838", "#e6e600", "#00b500"],
        "seg1": "30",
        "seg2": "60",
        "x": 700,
        "y": 200,
        "wires": []
    },
    {
        "id": "gauge_presion",
        "type": "ui_gauge",
        "z": "tab_lab6_act1",
        "name": "Presion",
        "group": "ui_group_lab6",
        "order": 3,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Presion",
        "label": "hPa",
        "format": "{{msg.presion.payload}}",
        "min": 950,
        "max": 1050,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "990",
        "seg2": "1030",
        "x": 700,
        "y": 260,
        "wires": []
    },
    {
        "id": "ui_group_lab6",
        "type": "ui_group",
        "name": "Telemetria IoT",
        "tab": "ui_tab_lab6",
        "order": 1,
        "disp": true,
        "width": "6"
    },
    {
        "id": "ui_tab_lab6",
        "type": "ui_tab",
        "name": "Lab 6 - Telemetria",
        "icon": "dashboard",
        "order": 1
    }
]
